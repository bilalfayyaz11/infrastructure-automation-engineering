<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Automated Deployment</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f7fa;
            color: #1f2937;
            text-align: center;
            padding-top: 80px;
        }

        .container {
            max-width: 760px;
            margin: 0 auto;
            background: #ffffff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        h1 {
            color: #15803d;
        }

        .metadata {
            margin-top: 30px;
            line-height: 1.8;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Application Deployed Successfully</h1>

        <p>
            This web application was deployed through a Jenkins and Ansible
            delivery pipeline.
        </p>

        <div class="metadata">
            <p><strong>Build Number:</strong> {{ build_number }}</p>
            <p><strong>Environment:</strong> {{ deployment_environment }}</p>
            <p><strong>Application Version:</strong> {{ app_version }}</p>
            <p><strong>Deployment Time:</strong> {{ ansible_facts["date_time"]["iso8601"] }}</p>
        </div>
    </div>
</body>
</html>
